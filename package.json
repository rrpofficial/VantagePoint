{
  "name": "porttrack",
  "version": "0.1.0",
  "private": true,
  "description": "Global portfolio tracking and Indian tax compliance platform for Indian tax residents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:functional": "vitest run tests/functional",
    "test:container": "vitest run --config vitest.container.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "docker compose --env-file .env.test down && rm -rf data-test && mkdir -p data-test && docker compose --env-file .env.test up -d --wait && playwright test",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc -b --pretty false && tsc -p apps/web/tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:test:up": "docker compose --env-file .env.test up --build -d",
    "docker:test:down": "docker compose --env-file .env.test down",
    "demo": "vitest run --config vitest.demo.config.ts",
    "vault:diagnose": "node scripts/diagnose-vault.mjs",
    "vault:rates:import": "tsx scripts/import-rates.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@porttrack/test-kit": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  }
}
