# VantagePoint runtime configuration (PRD FR-8.2 / FR-8.3).
# Copy to .env and adjust. NEVER commit the populated .env — it is gitignored.

# Which instance this file describes. Separates the compose project, the two
# container names and the networks, so a production stack and a testing stack can
# run side by side without touching each other. Default: vantagepoint.
VANTAGEPOINT_PROJECT=vantagepoint

# Which image tag this instance runs. Separate tags mean rebuilding one instance
# cannot replace the image the other is already running. Default: test.
VANTAGEPOINT_IMAGE_TAG=test

# Host path for the encrypted vault. This is a BIND MOUNT onto your native disk
# (ADR-012), not a Docker-managed volume: the database stays visible, copyable
# and backup-able from the host, and survives `docker compose down`.
VANTAGEPOINT_DATA_DIR=./data

# Ownership of files written into VANTAGEPOINT_DATA_DIR. Set these to your own host
# user so the database is not owned by root (US-9.5). On Linux/macOS: `id -u` / `id -g`.
VANTAGEPOINT_UID=1000
VANTAGEPOINT_GID=1000

# The only published host port; the API stays on the internal network (US-9.3).
# Two instances MUST differ here — the port is the one thing Docker cannot
# namespace away, and the second stack simply fails to start on a taken port.
VANTAGEPOINT_WEB_PORT=5173

# Outbound network policy. `deny` is the default (ADR-010); enabling egress also
# requires starting the stack with -f compose.egress.yaml.
VANTAGEPOINT_EGRESS=deny

# NOTE: the vault passphrase is deliberately ABSENT. It is supplied per session
# through the UI and never touches an image layer, this file, or disk (ADR-014).
